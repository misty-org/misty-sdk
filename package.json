{
  "name": "misty-sdk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @misty/sdk",
    "lint": "eslint packages --config eslint.config.js",
    "test": "vitest run",
    "check:license": "node scripts/check_no_agpl.mjs",
    "check": "npm run check:license && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
