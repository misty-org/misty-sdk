{
  "name": "misty-sdk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -b packages/sdk packages/sdk-react",
    "lint": "eslint packages --config eslint.config.js",
    "test": "vitest run",
    "check:license": "node scripts/check-no-agpl.mjs",
    "check": "npm run check:license && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
