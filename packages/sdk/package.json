{
  "name": "@misty/sdk",
  "version": "0.2.0",
  "description": "Build apps for a Misty Space: Space files, live Yjs rooms, presence, chat, calls and agent tools over Misty's channel.",
  "license": "MIT",
  "author": "misty-org",
  "homepage": "https://github.com/misty-org/misty-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misty-org/misty-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/misty-org/misty-sdk/issues",
  "keywords": ["misty", "sdk", "yjs", "crdt", "collaboration", "realtime", "mcp", "agents", "codemirror", "monaco", "prosemirror", "tiptap"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/misty-sdk.js",
  "jsdelivr": "./dist/misty-sdk.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./store": { "types": "./dist/bindings/store.d.ts", "default": "./dist/bindings/store.js" },
    "./codemirror": { "types": "./dist/bindings/codemirror.d.ts", "default": "./dist/bindings/codemirror.js" },
    "./monaco": { "types": "./dist/bindings/monaco.d.ts", "default": "./dist/bindings/monaco.js" },
    "./prosemirror": { "types": "./dist/bindings/prosemirror.d.ts", "default": "./dist/bindings/prosemirror.js" },
    "./tiptap": { "types": "./dist/bindings/tiptap.d.ts", "default": "./dist/bindings/tiptap.js" },
    "./misty-sdk.js": "./dist/misty-sdk.js",
    "./misty_theme.css": "./misty_theme.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "misty_theme.css", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b && node scripts/standalone.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lib0": "^0.2.99",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "monaco-editor": ">=0.40.0",
    "prosemirror-model": "^1.19.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-view": "^1.32.0",
    "y-codemirror.next": "^0.3.5",
    "y-monaco": "^0.1.6",
    "y-prosemirror": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": { "optional": true },
    "@codemirror/view": { "optional": true },
    "monaco-editor": { "optional": true },
    "prosemirror-model": { "optional": true },
    "prosemirror-state": { "optional": true },
    "prosemirror-view": { "optional": true },
    "y-codemirror.next": { "optional": true },
    "y-monaco": { "optional": true },
    "y-prosemirror": { "optional": true }
  },
  "devDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "esbuild": "^0.21.5",
    "monaco-editor": "^0.52.0",
    "prosemirror-model": "^1.19.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-view": "^1.32.0",
    "y-codemirror.next": "^0.3.5",
    "y-monaco": "^0.1.6",
    "y-prosemirror": "^1.2.0"
  }
}
